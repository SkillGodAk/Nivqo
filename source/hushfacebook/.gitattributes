#
# https://help.github.com/articles/dealing-with-line-endings/
#

# Normalise on checkin, check out with LF everywhere except the Windows scripts below.
* text=auto eol=lf
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Saved fuzz findings are raw input bytes, so no line ending conversion may touch them
/tools/fuzz/regressions/** binary

